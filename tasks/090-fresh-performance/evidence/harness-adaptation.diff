+def stopped_boundaries(diagnostics, host_identity, operation_id):
+    """Distinguish the direct owner barrier from the process supervisor record.
+
+    Both current records are required once, with actual Host identity. Their
+    receive times are observation upper bounds, not the instant each join ran.
+    Do not assume ordering between concurrent producers of diagnostic records.
+    """
+    stopped = [(record, at) for record, at in diagnostics
+               if record.get("event") == "host.stopped"]
+    assert len(stopped) == 2, stopped
+    boundaries = {}
+    for record, at in stopped:
+        component = record["component"]
+        assert component in ("host.owner", "host.process"), record
+        assert component not in boundaries, stopped
+        assert record["schema_version"] == 1 and record["scope"] == "HOST", record
+        assert record["level"] == "INFO", record
+        assert_identity(record, host_identity)
+        if component == "host.owner":
+            assert record["operation_id"] == operation_id, record
+            assert record["attributes"]["phase"] == "stopped", record
+        boundaries[component] = at
+    return boundaries
+
